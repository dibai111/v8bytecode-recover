{
  "name": "v8bytecode-recover",
  "version": "0.8.0",
  "description": "PowerShell-first recovery and analysis toolkit for V8 cached bytecode.",
  "type": "module",
  "bin": {
    "v8bytecode-recover": "bin/v8bytecode-recover.mjs",
    "v8bytecode-benchmark": "bin/v8bytecode-benchmark.mjs",
    "v8bytecode-profiles": "bin/v8bytecode-profiles.mjs",
    "v8bytecode-inspect": "bin/v8bytecode-inspect.mjs",
    "v8bytecode-doctor": "bin/v8bytecode-doctor.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "engine/v8asm/LICENSE",
    "engine/v8asm/cached_data/",
    "engine/v8asm/source_recovery/",
    "v8bytecode-recover.ps1",
    "powershell/",
    "docs/"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "check": "node --check bin/v8bytecode-recover.mjs && node --check bin/v8bytecode-benchmark.mjs && node --check bin/v8bytecode-profiles.mjs && node --check bin/v8bytecode-inspect.mjs && node --check bin/v8bytecode-doctor.mjs",
    "test": "node --test",
    "profiles:generate": "node bin/v8bytecode-profiles.mjs generate",
    "profiles:discover": "node bin/v8bytecode-profiles.mjs discover",
    "profiles:validate": "node bin/v8bytecode-profiles.mjs validate",
    "profiles:list": "node bin/v8bytecode-profiles.mjs list"
  },
  "keywords": [
    "v8",
    "bytecode",
    "source-recovery",
    "jsc",
    "reverse-engineering"
  ],
  "license": "MIT"
}
